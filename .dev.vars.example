# FCI Operations — environment variable registry (NAMES ONLY, no real values).
#
# This file is the single maintained catalog of every configuration value the
# app reads. To use it locally: copy to `.dev.vars` (gitignored) and fill in
# real values there. On the hosted ChatGPT Sites environment, set the same
# names in the environment settings UI.
#
# LAW: real secrets, API keys, tokens, webhook URLs, and client secrets are
# NEVER committed to this repository, pasted into chat/email, or shown in the
# app (the UI reports Configured/Missing by name only). This file holds
# placeholders exclusively.

# ── App access (Sign in with ChatGPT allowlist) ──────────────────────────────
FCI_OFFICE_EMAILS=owner@example.com            # comma-separated sign-in allowlist
FCI_OFFICE_DOMAINS=                            # optional: whole-domain allowlist
FCI_ADMIN_EMAILS=owner@example.com             # Administrator tier (dollar KPIs, settings writes)
FCI_LOCAL_DEV_USER_EMAIL=owner@example.com     # local dev identity
FCI_APP_ENVIRONMENT=development
FCI_DEPLOYMENT_STAGE=development

# ── Session + request limits ─────────────────────────────────────────────────
FCI_SESSION_SECRET=                            # or FCI_SESSION_SECRET_FILE (path). MUST stay
                                               # empty unless employee OIDC is fully configured:
                                               # it belongs to the OIDC variable group, so any
                                               # value makes that group look partially enabled
                                               # and fails Cloud Run startup. When set, the value
                                               # must be 43 base64url chars (32 bytes).
FCI_REQUEST_RATE_LIMIT_CAPACITY=
FCI_REQUEST_RATE_LIMIT_REFILL_INTERVAL_MS=
FCI_REQUEST_RATE_LIMIT_REFILL_TOKENS=

# ── AI assistant (OpenAI) ────────────────────────────────────────────────────
OPENAI_API_KEY=                                # hosted env settings / .dev.vars ONLY
OPENAI_MODEL=                                  # optional override

# ── Google Maps (Cloud API key — no Workspace involvement) ───────────────────
GOOGLE_MAPS_BROWSER_API_KEY=                   # browser key, HTTP-referrer restricted;
                                               # set it and job-site map embeds go live

# ── Google integration mode ──────────────────────────────────────────────────
GOOGLE_INTEGRATION_MODE=simulation             # simulation | workspace — "workspace" is the live
                                               # value (any other string falls back to simulation)

# ── Google Workspace connector (live mode only; see task-checklists/02) ──────
GOOGLE_WORKSPACE_CLIENT_ID=
GOOGLE_WORKSPACE_CLIENT_SECRET=                # never in GitHub; hosted settings only
GOOGLE_WORKSPACE_OAUTH_REDIRECT_URI=
GOOGLE_WORKSPACE_ALLOWED_DOMAINS=
GOOGLE_WORKSPACE_AUTHORIZED_ACCOUNTS=          # the one admin-approved company account
GOOGLE_WORKSPACE_ENABLED_SERVICES=
GOOGLE_WORKSPACE_SHARED_DRIVE_ID=
GOOGLE_WORKSPACE_INTAKE_MAILBOX=
GOOGLE_WORKSPACE_CLIENT_DIRECTORY_SHEET_ID=
GOOGLE_WORKSPACE_CLIENT_APPOINTMENTS_CALENDAR_ID=
GOOGLE_WORKSPACE_FIELD_SCHEDULE_CALENDAR_ID=
GOOGLE_WORKSPACE_TOKEN_ENCRYPTION_KEY=         # AES-GCM keyring; never in GitHub
GOOGLE_WORKSPACE_TOKEN_ENCRYPTION_KEY_VERSION=
GOOGLE_WORKSPACE_DRIVE_PROVISIONING_ENABLED=   # true|false (the reader prefixes the short name)

# ── Google Chat notifications (all events off by default) ────────────────────
GOOGLE_CHAT_NOTIFICATIONS_ENABLED=false
GOOGLE_CHAT_SALES_WEBHOOK_URL=                 # webhook URLs are secrets; hosted settings only
GOOGLE_CHAT_OFFICE_OPS_WEBHOOK_URL=
GOOGLE_CHAT_FIELD_WEBHOOK_URL=
GOOGLE_CHAT_SERVICE_WEBHOOK_URL=

# ── Production Cloud Run boundary ONLY (unused on the Sites dev site) ────────
FCI_EMPLOYEE_OIDC_CLIENT_ID=
FCI_EMPLOYEE_OIDC_CLIENT_SECRET=               # or FCI_EMPLOYEE_OIDC_CLIENT_SECRET_FILE
FCI_EMPLOYEE_OIDC_REDIRECT_URI=
FCI_EMPLOYEE_OIDC_ALLOWED_HOSTED_DOMAIN=
FCI_CLOUD_SQL_INSTANCE_CONNECTION_NAME=
FCI_CLOUD_SQL_IP_TYPE=

# ── Migration-rehearsal command (production-runtime/ CLI, not the app) ──────
FCI_REHEARSAL_ACKNOWLEDGMENT=                  # required by `npm run db:rehearse:postgres-core`;
                                               # run-core-rehearsal.ts throws
                                               # missing_rehearsal_configuration without it

# PostgreSQL runtime (production only). loadProductionConfig FAILS CLOSED without
# the required names below — the Cloud Run runtime will not start.
FCI_POSTGRES_ACCESS_MODE=                      # required
FCI_POSTGRES_CONNECTION_MODE=                  # required
FCI_POSTGRES_DATABASE=                         # required
FCI_POSTGRES_USER=                             # required
FCI_POSTGRES_PASSWORD=                         # required: this OR FCI_POSTGRES_PASSWORD_FILE
FCI_POSTGRES_PASSWORD_FILE=                    # (path form; never a value in GitHub)
FCI_POSTGRES_SCHEMA=                           # required (rehearsal mode: fci_rehearsal_<name>)
FCI_POSTGRES_HOST=                             # loopback-only in the socket connection mode
FCI_POSTGRES_PORT=                             # optional, default 5432
FCI_POSTGRES_MIGRATION_ROLE=
FCI_POSTGRES_PUBLIC_SCHEMA_ACKNOWLEDGMENT=
FCI_POSTGRES_POOL_MAX=                         # optional tuning below this line
FCI_POSTGRES_CONNECTION_TIMEOUT_MS=
FCI_POSTGRES_QUERY_TIMEOUT_MS=
FCI_POSTGRES_STATEMENT_TIMEOUT_MS=
FCI_POSTGRES_LOCK_TIMEOUT_MS=
FCI_POSTGRES_IDLE_TIMEOUT_MS=
FCI_POSTGRES_IDLE_TRANSACTION_TIMEOUT_MS=
FCI_POSTGRES_KEEPALIVE_INITIAL_DELAY_MS=
FCI_POSTGRES_MAX_LIFETIME_SECONDS=
